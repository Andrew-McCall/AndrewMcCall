exports[`renderMarkdown formatting > everything at once 1`] = `
"<h2 id="title" class="group text-2xl font-bold text-green-400 mt-4 scroll-mt-20"><a href="#title" class="no-underline">Title<span class="opacity-0 group-hover:opacity-100 text-green-700 ml-2">#</span></a></h2>
<p class="leading-relaxed">Intro paragraph with <strong>bold</strong>, <em>italic</em>, <code class="bg-stone-900 text-lime-300 px-1">code</code> and a <a href="https://example.com" class="text-green-500 hover:text-green-400 underline" target="_blank" rel="noopener">link</a>.</p>
<h3 id="section" class="group text-xl font-bold text-green-400 mt-4 scroll-mt-20"><a href="#section" class="no-underline">Section<span class="opacity-0 group-hover:opacity-100 text-green-700 ml-2">#</span></a></h3>
<ul class="list-disc pl-6 flex flex-col gap-1"><li>one</li><li>two</li></ul>
<ol class="list-decimal pl-6 flex flex-col gap-1"><li>first</li><li>second</li></ol>
<blockquote class="border-l-2 border-green-700 pl-3 text-stone-400 italic">a quote</blockquote>
<pre class="bg-stone-900 border border-green-900 p-3 overflow-x-auto"><code class="text-lime-300 text-sm">const x = 1;</code></pre>
<hr class="border-green-900" />
<p class="leading-relaxed">Closing words.</p>"
`;

exports[`renderMarkdown formatting > external link 1`] = `"<p class="leading-relaxed">see <a href="https://example.com" class="text-green-500 hover:text-green-400 underline" target="_blank" rel="noopener">the site</a> now</p>"`;

