# Backend configuration. Copy to `backend/.env` and adjust:
#
#   cp backend/.env.example backend/.env
#
# `.env` is listed in backend/.gitignore and must never hold real credentials in
# a commit. deploy.sh sources the same file on the prod box, so the production
# copy lives only on that machine.

# --- database -------------------------------------------------------------
# Either one DSN...
DATABASE_DSN=postgres://postgres:postgres@127.0.0.1:5432/andrewmccall_dev
# ...or the parts, used only when DATABASE_DSN is unset:
# DATABASE_USERNAME=postgres
# DATABASE_PASSWORD=postgres
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_NAME=andrewmccall_dev

# --- server ---------------------------------------------------------------
ADDR=127.0.0.1
PORT=3000
RUST_LOG=info

# --- first admin ----------------------------------------------------------
# Inserted on startup only if no user with this name exists, so it is safe to
# leave set. Never reuses or overwrites an existing user's pin.
ADMIN_NAME=andrew
ADMIN_PIN=123456

# --- session cookie -------------------------------------------------------
# Must be false over plain http, or the browser drops the login cookie.
COOKIE_SECURE=false
# TOKEN_TTL_DAYS=30

# --- optional -------------------------------------------------------------
# Overrides the account the commit sync follows. Left unset, it uses the
# GitHub URL from the profile editor, so this is only needed to follow a
# different account than the one the site links to.
# GITHUB_USERNAME=
# GITHUB_TOKEN=
# GITHUB_SYNC_MINUTES=60
